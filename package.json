    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "0.160.1"
  },
  "devDependencies": {
    "@types/three": "0.160.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
